{
  "name": "codrut-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate-client": "openapi-typescript http://localhost:8000/api/openapi.json -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "^15.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "0.28.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.8",
    "js-yaml": "4.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "vite": "7.3.5",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "js-yaml": "4.2.0",
      "postcss": "8.5.16"
    }
  }
}
