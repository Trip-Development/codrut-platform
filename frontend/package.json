{
  "name": "codrut-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "generate-client": "openapi-typescript ${OPENAPI_URL:-http://localhost:8000/api/openapi.json} -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slider": "1.4.3",
    "@radix-ui/react-slot": "1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.24.0",
    "next": "^15.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "esbuild": "0.28.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.8",
    "js-yaml": "4.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "7.3.5",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.0.0": "1.1.16",
      "brace-expansion@^2.0.0": "2.1.2",
      "postcss@<8.5.10": "8.5.16",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
