# ==============================================================================
# Codrut Platform - Environment Variables Template (.env.example)
# ==============================================================================

# Compose project name for container namespace grouping
COMPOSE_PROJECT_NAME=codrut-platform

# ------------------------------------------------------------------------------
# Core Settings
# ------------------------------------------------------------------------------
# Active domain host (localhost in dev, app.codrut.ro in prod)
CODRUT_HOST=codrut.example.com
CODRUT_ENV=development

# Cookie session signature secret (replace with a secure random string in prod)
CODRUT_SESSION_SECRET=replace-with-a-long-random-secret

# Stable task/invite link signing secret (keep independent from the session secret in prod)
CODRUT_TASK_LINK_SECRET=replace-with-a-separate-long-random-secret

# Stable campaign asset ownership secret. Optional outside production; when omitted,
# the backend falls back to CODRUT_TASK_LINK_SECRET and then the legacy session secret.
CODRUT_CAMPAIGN_ASSET_SIGNING_SECRET=replace-with-another-long-random-secret

# Stable keyed fingerprint secret for bounce and unsubscribe enforcement. Keep this
# independent from every signing, session, provider, and webhook secret in production.
# Do not rotate it without the versioned re-key procedure in docs/ops/contact-data-retention.md.
CODRUT_EMAIL_SUPPRESSION_FINGERPRINT_SECRET=replace-with-a-dedicated-long-random-secret

# Allowed CORS Origins (must be a valid JSON array of strings)
CODRUT_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8000"]

# Absolute public URL (used to generate magic login links in outgoing emails)
CODRUT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Databases
# ------------------------------------------------------------------------------
# PostgreSQL credentials (isolated internally, not exposed to the public)
POSTGRES_DB=codrut
POSTGRES_USER=codrut
POSTGRES_PASSWORD=codrut

# Database connection URL (must match the credentials configured above)
CODRUT_DATABASE_URL=postgresql+asyncpg://codrut:codrut@db:5432/codrut
# Each API process and the worker use this bounded SQLAlchemy pool. Four
# production API workers with these defaults remain below PostgreSQL's
# connection limit while allowing short bursts.
CODRUT_DB_POOL_SIZE=5
CODRUT_DB_MAX_OVERFLOW=5
CODRUT_DB_POOL_TIMEOUT_SECONDS=10
CODRUT_API_WORKERS=4
# One outbox cron may use eight isolated claim sessions; at most two other
# database-backed jobs may overlap so the worker stays within its 10-connection pool.
CODRUT_WORKER_MAX_JOBS=3
# Alembic fails instead of waiting indefinitely for a conflicting production lock.
CODRUT_MIGRATION_LOCK_TIMEOUT_MS=5000
CODRUT_MIGRATION_STATEMENT_TIMEOUT_MS=900000

# Host path to mount the persistent PostgreSQL database volume in production (e.g., /mnt/HC_Volume_...)
CODRUT_DB_VOLUME_PATH=/mnt/postgres_data

# Redis connection URL for temporary caching and task worker queues
CODRUT_REDIS_URL=redis://redis:6379/0

# Exact IPs or CIDRs for reverse proxies allowed to supply X-Forwarded-For.
# Keep empty outside production; replace this example with the deployed proxy address or network.
CODRUT_RATE_LIMIT_TRUSTED_PROXIES=["10.0.0.2"]
# Allows a 1,000-person launch behind one company NAT while keeping a finite abuse ceiling.
CODRUT_RATE_LIMIT_INVITE_EXCHANGE_MAX_REQUESTS=2000
CODRUT_MAINTENANCE_MODE=false
# Set only for an announced load-test window; use a unique secret of at least 32 characters.
CODRUT_MAINTENANCE_BYPASS_TOKEN=

# ------------------------------------------------------------------------------
# Frontend & Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=/api

# Authentication bypass / Demo fallback
# - true: Bypasses authentication in dev, using mock sessions for fast UI testing.
# - false: Enforces database session verification (redirects to /login if unauth).
CODRUT_FRONTEND_DEMO_FALLBACK=false
NEXT_PUBLIC_CODRUT_FRONTEND_DEMO_FALLBACK=false
# Local Compose resolves real seeded users by route so trainer and participant
# views can be opened without logging in. Production Compose forces this off.
CODRUT_LOCAL_AUTH_BYPASS=true
NEXT_PUBLIC_CODRUT_LOCAL_AUTH_BYPASS=true

# ------------------------------------------------------------------------------
# Local Machine Port Bindings
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Traefik ACME registration email (for Let's Encrypt certificates in prod)
TRAEFIK_ACME_EMAIL=ops@example.com

# ------------------------------------------------------------------------------
# Email Delivery Settings
# ------------------------------------------------------------------------------
# Email provider method: 'mailpit' (local dev testing) or 'brevo' (production live)
CODRUT_EMAIL_PROVIDER=mailpit

# Default sender details
CODRUT_EMAIL_FROM_ADDRESS=no-reply@codrut.local
CODRUT_EMAIL_FROM_NAME=Andrei Văcaru

# Brevo transactional API Key (required when CODRUT_EMAIL_PROVIDER=brevo)
CODRUT_EMAIL_BREVO_API_KEY=
# Independent bearer token configured on the Brevo transactional webhook.
CODRUT_EMAIL_WEBHOOK_TOKEN=

# Controlled launch allowance. The UI shows remaining capacity before a send.
CODRUT_EMAIL_DAILY_SEND_CAP=2000
# Allows only outbox rows explicitly marked for Brevo sandbox delivery.
# Normal messages remain live; keep this false outside an announced maintenance test.
CODRUT_EMAIL_BREVO_SANDBOX_ENABLED=false
CODRUT_EMAIL_OUTBOX_BATCH_SIZE=100
CODRUT_EMAIL_OUTBOX_CONCURRENCY=8
CODRUT_READINESS_TIMEOUT_SECONDS=3
CODRUT_WORKER_HEARTBEAT_TTL_SECONDS=30
CODRUT_OUTBOX_BACKLOG_MAX_PENDING=5000
CODRUT_OUTBOX_BACKLOG_MAX_AGE_SECONDS=1800
# Contacts remain recoverable in Archive for this many days before direct
# identifiers and memberships are purged.
CODRUT_CAMPAIGN_RECIPIENT_ARCHIVE_RETENTION_DAYS=30
CODRUT_CAMPAIGN_RECIPIENT_DELIVERY_RECONCILIATION_DAYS=7
# The contract migration removes direct identifiers before automatic purge runs.
CODRUT_CAMPAIGN_RECIPIENT_PURGE_ENABLED=true
# Keyed provider-message/event lookup receipts expire independently of any
# longer-lived do-not-contact fingerprint.
CODRUT_CAMPAIGN_DELIVERY_TOMBSTONE_RETENTION_DAYS=365
# Suppression fingerprints are protected pseudonymous data and must be reviewed
# for continued necessity on this cadence.
CODRUT_EMAIL_SUPPRESSION_REVIEW_DAYS=365

# Local SMTP configurations (fallback or manual configurations)
CODRUT_EMAIL_SMTP_HOST=mailpit
CODRUT_EMAIL_SMTP_PORT=1025
CODRUT_EMAIL_SMTP_USERNAME=
CODRUT_EMAIL_SMTP_PASSWORD=
CODRUT_EMAIL_SMTP_STARTTLS=false

# ------------------------------------------------------------------------------
# Database Seeder Configuration
# ------------------------------------------------------------------------------
# Credentials for seeding the first Trainer account locally
CODRUT_SEED_TRAINER_EMAIL=trainer@example.com
CODRUT_SEED_TRAINER_PASSWORD=replace-with-a-long-test-password
CODRUT_SEED_PARTICIPANT_EMAIL=test@gmail.com
CODRUT_SEED_PARTICIPANT_PASSWORD=replace-with-a-long-test-password
CODRUT_SEED_COMPANY_NAME="Pilot Cody"
