# ==============================================================================
# 🌲 Codrut Platform - Environment Configuration Template (.env.example)
# ==============================================================================
# Use this file as a template for setting up your local '.env' file.
# Copy this file to '.env' and adjust the variables to fit your environment.
# E.g., 'cp .env.example .env'
# ==============================================================================

# 📦 Docker Compose Orchestration Config
# Name of the Docker compose project (groups your containers together)
COMPOSE_PROJECT_NAME=codrut-platform

# ------------------------------------------------------------------------------
# 🌐 Core Application Configurations
# ------------------------------------------------------------------------------
# Host domain name where your app is served (localhost in dev, app.codrut.ro in prod)
CODRUT_HOST=codrut.example.com

# Deployment environment profile ('development' or 'production')
CODRUT_ENV=development

# Encryption secret for signing user session cookies. 
# ⚠️ SECURITY: Make sure to replace this with a long, cryptographically strong random string in production!
CODRUT_SESSION_SECRET=replace-with-a-long-random-secret

# Allowed Cross-Origin Resource Sharing (CORS) domains (must be a valid JSON array of URLs)
CODRUT_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8000"]

# The absolute public entry URL of the application.
# 📧 IMPORTANT: This is used to build the magic login links sent out in participant emails.
CODRUT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 💾 Database & Cache Configurations
# ------------------------------------------------------------------------------
# PostgreSQL database credentials for the internal container database
POSTGRES_DB=codrut
POSTGRES_USER=codrut
POSTGRES_PASSWORD=codrut

# Primary PostgreSQL connection URL.
# 🔗 NOTE: This MUST use the same username, password, and database configured in POSTGRES_* above.
# The hostname is 'db' because it resolves to the internal PostgreSQL container.
CODRUT_DATABASE_URL=postgresql+asyncpg://codrut:codrut@db:5432/codrut

# Redis connection URL (used for temporary caching and backend async task queue)
CODRUT_REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 🔐 Authentication & Demo Fallbacks
# ------------------------------------------------------------------------------
# Prefix path for all API routes (routed by Traefik to the backend container)
NEXT_PUBLIC_API_BASE_URL=/api

# Developer Authentication Bypass (Demo Fallback)
# - Set to 'true' (Default for quick dev): Bypasses real login layouts, giving you a mock session.
# - Set to 'false' (Mandatory for prod/security testing): Enforces real database token checks
#   and redirects you to '/login' if you don't have a valid active session.
CODRUT_FRONTEND_DEMO_FALLBACK=false
NEXT_PUBLIC_CODRUT_FRONTEND_DEMO_FALLBACK=false

# ------------------------------------------------------------------------------
# 🔌 Port Allocations (Local Host Machine Bindings)
# ------------------------------------------------------------------------------
# Custom ports exposed on your local machine. Change these if they conflict with other local services.
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Traefik ACME Certificate Email (used by Let's Encrypt to register SSL certificates in production)
TRAEFIK_ACME_EMAIL=ops@example.com

# ------------------------------------------------------------------------------
# ✉️ Outgoing Email Configurations
# ------------------------------------------------------------------------------
# Email provider method:
# - 'mailpit': Captures all outbound emails locally (perfect for dev testing, viewable at http://localhost:8025)
# - 'brevo': Delivers live emails to user inboxes using Brevo's transactional API (production default)
CODRUT_EMAIL_PROVIDER=mailpit

# Default sender details
CODRUT_EMAIL_FROM_ADDRESS=no-reply@codrut.local
CODRUT_EMAIL_FROM_NAME=Codruț

# Brevo API Key (Required only if CODRUT_EMAIL_PROVIDER=brevo)
CODRUT_EMAIL_BREVO_API_KEY=

# Local SMTP Configurations (used when provider is mailpit or a custom SMTP is needed)
CODRUT_EMAIL_SMTP_HOST=mailpit
CODRUT_EMAIL_SMTP_PORT=1025
CODRUT_EMAIL_SMTP_USERNAME=
CODRUT_EMAIL_SMTP_PASSWORD=
CODRUT_EMAIL_SMTP_STARTTLS=false

# ------------------------------------------------------------------------------
# 🚀 Database Seeder Settings (Seed Initial Pilot Data)
# ------------------------------------------------------------------------------
# These credentials will be used to automatically seed your first Trainer account
# when running: 'docker compose exec backend uv run python -m codrut.tools.seed_pilot'
CODRUT_SEED_TRAINER_EMAIL=trainer@example.com
CODRUT_SEED_TRAINER_PASSWORD=replace-with-a-long-test-password
CODRUT_SEED_COMPANY_NAME="Pilot Codruț"
