# ==============================================================================
# Codrut Platform - Environment Variables Template (.env.example)
# ==============================================================================

# Docker compose orchestration name
COMPOSE_PROJECT_NAME=codrut-platform

# ------------------------------------------------------------------------------
# Core Platform Config
# ------------------------------------------------------------------------------
# Active host domain (e.g. app.codrut.ro in prod, localhost in dev)
CODRUT_HOST=codrut.example.com
CODRUT_ENV=development

# Cookie session signature key (use a long random secret in production)
CODRUT_SESSION_SECRET=replace-with-a-long-random-secret

# Allowed CORS Origins (JSON array of strings)
CODRUT_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8000"]

# Absolute public app entry URL (used to generate magic login links in emails)
CODRUT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Configurations
# ------------------------------------------------------------------------------
POSTGRES_DB=codrut
POSTGRES_USER=codrut
POSTGRES_PASSWORD=codrut

# Database connection URL (must align with POSTGRES_* credentials above)
CODRUT_DATABASE_URL=postgresql+asyncpg://codrut:codrut@db:5432/codrut

# Redis cache and background queue connection URL
CODRUT_REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Frontend & Auth Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=/api

# Authentication Bypass / Demo Fallback
# - Set to 'true' to bypass authentication and preview workspaces locally without log in.
# - Set to 'false' to enforce full backend session verification (redirects to /login).
CODRUT_FRONTEND_DEMO_FALLBACK=false
NEXT_PUBLIC_CODRUT_FRONTEND_DEMO_FALLBACK=false

# ------------------------------------------------------------------------------
# Port Allocations (Local Machine Bindings)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Traefik Let's Encrypt Email Registration (Production HTTPS)
TRAEFIK_ACME_EMAIL=ops@example.com

# ------------------------------------------------------------------------------
# Outgoing Email Configurations
# ------------------------------------------------------------------------------
# Email provider: 'mailpit' (local dev capture) or 'brevo' (production live)
CODRUT_EMAIL_PROVIDER=mailpit
CODRUT_EMAIL_FROM_ADDRESS=no-reply@codrut.local
CODRUT_EMAIL_FROM_NAME=Codruț

# Brevo configuration (SMTP transaction API key)
CODRUT_EMAIL_BREVO_API_KEY=

# Local SMTP SMTP configs (fallback or manual setups)
CODRUT_EMAIL_SMTP_HOST=mailpit
CODRUT_EMAIL_SMTP_PORT=1025
CODRUT_EMAIL_SMTP_USERNAME=
CODRUT_EMAIL_SMTP_PASSWORD=
CODRUT_EMAIL_SMTP_STARTTLS=false

# ------------------------------------------------------------------------------
# Pilot Database Seeder Configurations
# ------------------------------------------------------------------------------
CODRUT_SEED_TRAINER_EMAIL=trainer@example.com
CODRUT_SEED_TRAINER_PASSWORD=replace-with-a-long-test-password
CODRUT_SEED_COMPANY_NAME="Pilot Codruț"
