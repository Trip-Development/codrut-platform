FROM node:22-bookworm AS dev

ENV PNPM_HOME=/home/node/.local/share/pnpm \
    PATH=/home/node/.local/share/pnpm:$PATH

WORKDIR /workspace/frontend
RUN chown -R node:node /workspace/frontend
RUN npm install -g pnpm@10.11.0

COPY --chown=node:node frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY --chown=node:node frontend ./
USER node

CMD ["pnpm", "dev", "--hostname", "0.0.0.0", "--port", "3000"]

FROM dev AS build
RUN pnpm build

FROM node:22-bookworm AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /workspace/frontend
RUN npm install -g pnpm@10.11.0

COPY --from=build --chown=node:node /workspace/frontend/package.json ./package.json
COPY --from=build --chown=node:node /workspace/frontend/node_modules ./node_modules
COPY --from=build --chown=node:node /workspace/frontend/.next ./.next
COPY --from=build --chown=node:node /workspace/frontend/public ./public
COPY --from=build --chown=node:node /workspace/frontend/next.config.mjs ./next.config.mjs

USER node
EXPOSE 3000
CMD ["pnpm", "start"]
