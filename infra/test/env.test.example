# ==============================================================================
# Exemplu de fișier de mediu pentru Casa de Probă (cody-test)
# Copiază acest fișier în infra/test/.env pe server și înlocuiește valorile GENEREAZA.
# NU puneți secrete reale în git!
# ==============================================================================

# 1. Identificatori stivă Docker Compose
COMPOSE_PROJECT_NAME=cody-test
BACKEND_IMAGE=ghcr.io/trip-development/codrut-platform-backend:test-INSEREAZA_SHA
FRONTEND_IMAGE=ghcr.io/trip-development/codrut-platform-frontend:test-INSEREAZA_SHA

# 2. Configurare Bază de Date Izolată (testdb)
POSTGRES_USER=codytest
POSTGRES_DB=codytest
POSTGRES_PASSWORD=GENEREAZA_PAROLA_POSTGRES_TEST

# 3. Domeniu și Acces Web
CODRUT_ENV=production
CODRUT_HOST=test.cody.andreivacaru.ro
CODRUT_PUBLIC_APP_URL=https://test.cody.andreivacaru.ro
CODRUT_CORS_ORIGINS=["https://test.cody.andreivacaru.ro"]

# 4. Pool și Resurse Reduse pentru Test
CODRUT_API_WORKERS=2
CODRUT_DB_POOL_SIZE=3
CODRUT_DB_MAX_OVERFLOW=2

# 5. Secrete de Criptare și Semnare (generate aleator, minim 32 caractere)
CODRUT_SESSION_SECRET=GENEREAZA_SECRET_SESIUNE_TEST_MIN_32_CHARS
CODRUT_TASK_LINK_SECRET=GENEREAZA_SECRET_LINK_TASK_TEST_MIN_32_CHARS
CODRUT_CAMPAIGN_ASSET_SIGNING_SECRET=GENEREAZA_SECRET_ASSET_SIGNING_TEST_MIN_32_CHARS
CODRUT_EMAIL_SUPPRESSION_FINGERPRINT_SECRET=GENEREAZA_SECRET_FINGERPRINT_TEST_MIN_32_CHARS

# 6. EMAIL — PROTECȚIE TOTALĂ (0 emailuri reale trimise)
# Modul sandbox forțează antetul 'X-Sib-Sandbox: drop', iar cheia invalidă blochează orice livrare.
CODRUT_EMAIL_PROVIDER=brevo
CODRUT_EMAIL_BREVO_SANDBOX_ENABLED=true
CODRUT_EMAIL_BREVO_API_KEY=CHEIE-INVALIDA-INTENTIONAT
CODRUT_EMAIL_DAILY_SEND_CAP=0
CODRUT_EMAIL_FROM_ADDRESS=test@andreivacaru.ro
CODRUT_EMAIL_FROM_NAME=Cody Test
CODRUT_EMAIL_WEBHOOK_TOKEN=GENEREAZA_TOKEN_WEBHOOK_TEST

# 7. Rate Limiting și Securitate Rețea
CODRUT_RATE_LIMIT_TRUSTED_PROXIES=["127.0.0.1/32","172.16.0.0/12","10.0.0.0/8"]
