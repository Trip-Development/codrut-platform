# ==============================================================================
# Exemplu de fișier de mediu pentru Casa de Probă (cody-test)
# Copiază acest fișier în /opt/cody-test/.env pe server și înlocuiește valorile GENEREAZA.
# NU puneți secrete reale în git!
# ==============================================================================

# 1. Identificatori stivă Docker Compose
COMPOSE_PROJECT_NAME=cody-test
BACKEND_IMAGE=ghcr.io/trip-development/codrut-platform-backend:test-INSEREAZA_SHA
FRONTEND_IMAGE=ghcr.io/trip-development/codrut-platform-frontend:test-INSEREAZA_SHA

# 2. Configurare Bază de Date Izolată (testdb)
# IMPORTANT: Parola trebuie să conțină DOAR litere și cifre (fără caractere speciale @, :, /, #)
POSTGRES_USER=codytest
POSTGRES_DB=codytest
POSTGRES_PASSWORD=GENEREAZA_PAROLA_POSTGRES_DOAR_LITERE_SI_CIFRE

# 3. Adrese de Conectare Interne
CODRUT_DATABASE_URL=postgresql+asyncpg://codytest:GENEREAZA_PAROLA_POSTGRES_DOAR_LITERE_SI_CIFRE@testdb:5432/codytest
CODRUT_REDIS_URL=redis://testredis:6379/0

# 4. Domeniu și Acces Web
CODRUT_ENV=production
CODRUT_HOST=test.cody.andreivacaru.ro
CODRUT_PUBLIC_APP_URL=https://test.cody.andreivacaru.ro
CODRUT_CORS_ORIGINS=["https://test.cody.andreivacaru.ro"]

# 5. Pool Bază de Date și Concurență (Regula de Siguranță: concurrency + worker_jobs - 1 <= pool_size + max_overflow)
# Calcul: 2 + 2 - 1 = 3 <= 3 + 2 = 5 (VALID)
CODRUT_API_WORKERS=2
CODRUT_WORKER_MAX_JOBS=2
CODRUT_EMAIL_OUTBOX_CONCURRENCY=2
CODRUT_EMAIL_OUTBOX_BATCH_SIZE=10
CODRUT_DB_POOL_SIZE=3
CODRUT_DB_MAX_OVERFLOW=2
CODRUT_DB_POOL_TIMEOUT_SECONDS=10

# 6. Secrete de Criptare și Semnare (generate aleator prin openssl rand -hex 32)
# CRITIC: Toate cele 5 secrete trebuie să aibă MINIMUM 32 de caractere și să fie DIFERITE între ele!
CODRUT_SESSION_SECRET=GENEREAZA_SECRET_SESIUNE_TEST_MIN_32_CHARS
CODRUT_TASK_LINK_SECRET=GENEREAZA_SECRET_LINK_TASK_TEST_MIN_32_CHARS
CODRUT_CAMPAIGN_ASSET_SIGNING_SECRET=GENEREAZA_SECRET_ASSET_SIGNING_TEST_MIN_32_CHARS
CODRUT_EMAIL_SUPPRESSION_FINGERPRINT_SECRET=GENEREAZA_SECRET_FINGERPRINT_TEST_MIN_32_CHARS
CODRUT_EMAIL_WEBHOOK_TOKEN=GENEREAZA_TOKEN_WEBHOOK_TEST_MIN_32_CHARS

# 7. EMAIL — PROTECȚIE TOTALĂ (0 emailuri reale trimise)
# Modul sandbox forțează antetul 'X-Sib-Sandbox: drop', iar cheia invalidă blochează orice livrare.
CODRUT_EMAIL_PROVIDER=brevo
CODRUT_EMAIL_BREVO_SANDBOX_ENABLED=true
CODRUT_EMAIL_BREVO_API_KEY=CHEIE-INVALIDA-INTENTIONAT
CODRUT_EMAIL_DAILY_SEND_CAP=0
CODRUT_EMAIL_FROM_ADDRESS=test@andreivacaru.ro
CODRUT_EMAIL_FROM_NAME=Cody Test

# 8. Rate Limiting și Securitate Rețea
CODRUT_RATE_LIMIT_TRUSTED_PROXIES=["127.0.0.1/32","172.16.0.0/12","10.0.0.0/8"]
CODRUT_CAMPAIGN_ASSET_DIR=/app/var/campaign-assets
CODRUT_CAMPAIGN_ASSET_PUBLIC_PATH=/api/campaign-assets
CODRUT_READINESS_TIMEOUT_SECONDS=3

# 9. Comunicare internă Server-Side (Frontend -> Backend)
# OBLIGATORIU: La randare pe server, frontend-ul apelează backend-ul intern.
# Serviciul fiind redenumit în testbackend, această variabilă este obligatorie.
INTERNAL_API_BASE_URL=http://testbackend:8000/api

